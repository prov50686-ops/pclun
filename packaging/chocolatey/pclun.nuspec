<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>pclun</id>
    <version>0.4.0</version>
    <title>PcLun</title>
    <authors>MrDomik</authors>
    <projectUrl>https://github.com/prov50686-ops/pclun</projectUrl>
    <licenseUrl>https://github.com/prov50686-ops/pclun</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Minecraft 1.16.5 + OptiFine launcher (Pro Edition).</summary>
    <description>
      PcLun — Avalonia-based launcher for MC 1.16.5 + OptiFine, with multi-instance,
      Modrinth, server browser, friends/chat, achievements, cloud backup, theme,
      diagnostics, and packaging.
    </description>
    <tags>minecraft launcher optifine forge fabric pclun</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
