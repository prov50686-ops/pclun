<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PcLun.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="PcLun.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Title="PcLun by MrDomik — Minecraft 1.16.5 OptiFine"
        Icon="/app.ico"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        ExtendClientAreaToDecorationsHint="False"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="220,*">

        <!-- ========== SIDEBAR ========== -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- Brand -->
                <Border DockPanel.Dock="Top" Padding="22,22,22,18">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="9"
                                    Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="P" Foreground="#000" FontSize="18" FontWeight="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="brand" Text="PcLun" />
                                <TextBlock Classes="dim" Text="by MrDomik · Ultra FPS" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer (online + user) -->
                <Border DockPanel.Dock="Bottom" Padding="14" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Spacing="10">
                        <Border Classes="pill-success">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="{Binding OnlineStatusText}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Classes="field" Padding="10,8">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="7"
                                        Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="{Binding NicknameInitial}" Foreground="#000"
                                               FontWeight="Black" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Classes="dim" Text="{Binding AccountModeLabel}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,4,14,14" Spacing="4">

                        <TextBlock Classes="label" Text="Лаунчер" Margin="6,8,6,2" />

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsHomeTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="▶" FontSize="13" Width="16" />
                                <TextBlock Text="Главная" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsServersTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="◇" FontSize="13" Width="16" />
                                <TextBlock Text="Серверы" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Classes="label" Text="Настройки" Margin="6,12,6,2" />

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsGraphicsTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="▥" FontSize="13" Width="16" />
                                <TextBlock Text="Графика и FPS" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsOptifineTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="✦" FontSize="13" Width="16" />
                                <TextBlock Text="OptiFine" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsJavaTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="◆" FontSize="13" Width="16" />
                                <TextBlock Text="Java и JVM" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Classes="label" Text="Аккаунт" Margin="6,12,6,2" />

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsAccountTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="◉" FontSize="13" Width="16" />
                                <TextBlock Text="Профиль" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsContentTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="◫" FontSize="13" Width="16" />
                                <TextBlock Text="Контент" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsCommunityTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="✦" FontSize="13" Width="16" />
                                <TextBlock Text="Сообщество" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsProTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="★" FontSize="13" Width="16" />
                                <TextBlock Text="Pro" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsToolsTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="⚙" FontSize="13" Width="16" />
                                <TextBlock Text="Инструменты" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding IsAboutTab, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="ⓘ" FontSize="13" Width="16" />
                                <TextBlock Text="О лаунчере" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- ========== CONTENT ========== -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto">

            <!-- Status bar -->
            <Border Grid.Row="1" Padding="24,14"
                    Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Classes="cell" Grid.Column="0" Spacing="6">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                     IsIndeterminate="{Binding IsIndeterminate}"
                                     IsVisible="{Binding IsBusy}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="dim"
                               Text="{Binding CurrentLauncherVersion, StringFormat='PcLun {0} by MrDomik · MC 1.16.5 + OptiFine'}"
                               VerticalAlignment="Center" Margin="20,0,0,0" />
                </Grid>
            </Border>

            <!-- Content area -->
            <ScrollViewer Grid.Row="0" Padding="0">
                <Grid RowDefinitions="Auto,*">

                    <!-- Update banner -->
                    <Border Grid.Row="0" IsVisible="{Binding UpdateAvailable}"
                            Padding="20,10" Background="#3aff7a14" BorderBrush="#80ff7a14" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding UpdateBannerText}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Открыть Releases"
                                    Command="{Binding OpenLatestReleaseCommand}" />
                            <Button Grid.Column="2" Margin="6,0,0,0" Content="Позже"
                                    Click="DismissUpdate_Click" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                    <!-- Home -->
                    <Grid IsVisible="{Binding IsHomeTab}" Margin="36,32,36,28">
                        <Grid RowDefinitions="Auto,Auto,*">

                            <!-- Hero -->
                            <Border Grid.Row="0" Classes="hero">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="cell" Grid.Column="0" Spacing="10">
                                        <TextBlock Classes="label" Text="Готов играть" />
                                        <TextBlock Classes="h1" Text="Minecraft 1.16.5" />
                                        <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                                   Text="OptiFine HD U G8 · профиль оптимизации применяется автоматически перед каждым запуском." />
                                        <TextBlock Classes="dim" Margin="0,4,0,0"
                                                   Text="Лаунчер by MrDomik" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                            <Border Classes="pill">
                                                <TextBlock Text="{Binding ProfileBadge}" FontSize="11" />
                                            </Border>
                                            <Border Classes="pill">
                                                <TextBlock Text="{Binding RamBadge}" FontSize="11" />
                                            </Border>
                                            <Border Classes="pill">
                                                <TextBlock Text="{Binding ResolutionBadge}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center"
                                                MinWidth="220">
                                        <Button Classes="play"
                                                Content="{Binding PlayButtonText}"
                                                Command="{Binding PlayCommand}"
                                                IsEnabled="{Binding CanPlay}"
                                                HorizontalAlignment="Stretch" />
                                        <Button Content="📁 Открыть папку с игрой"
                                                Command="{Binding OpenGameDirCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Quick controls -->
                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,18,0,0">
                                <Border Grid.Column="0" Classes="card" Margin="0,0,9,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="label" Text="Никнейм" />
                                        <TextBox Text="{Binding Nickname}" />
                                        <TextBlock Classes="dim" Text="Используется для офлайн-входа." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="card" Margin="9,0,9,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="label" Text="FPS-профиль" />
                                        <ComboBox SelectedIndex="{Binding FpsProfileIndex}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="🥔  Potato — экстрим, для самых слабых ПК" />
                                            <ComboBoxItem Content="⚡  Ultra FPS — рекомендуется на 2-4 ГБ ОЗУ" />
                                            <ComboBoxItem Content="◐  Сбалансированный" />
                                            <ComboBoxItem Content="✦  Качество — для мощных ПК" />
                                        </ComboBox>
                                        <TextBlock Classes="dim" Text="{Binding FpsProfileDescription}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Classes="card" Margin="9,0,0,0">
                                    <StackPanel Spacing="8">
                                        <DockPanel>
                                            <TextBlock Classes="label" Text="ОЗУ для игры" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding RamMbDisplay}" Classes="h3"
                                                       HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <Slider Minimum="1024" Maximum="{Binding MaxRamMb}" TickFrequency="512"
                                                SmallChange="256" LargeChange="512"
                                                Value="{Binding RamMb}" />
                                        <TextBlock Classes="dim" Text="{Binding RamHint}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Recent / tips -->
                            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,18,0,0">
                                <Border Grid.Column="0" Classes="card" Margin="0,0,9,0">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h3" Text="Что делает PcLun by MrDomik" />
                                        <Border Classes="divider" />
                                        <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                                   Text="• Авто-установка Java 8 (Adoptium) и Minecraft 1.16.5 с проверкой SHA-1." />
                                        <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                                   Text="• Установка OptiFine HD U G8 в headless-режиме." />
                                        <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                                   Text="• G1GC + Aikar-style JVM-флаги, авто-Xmx по системной RAM." />
                                        <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                                   Text="• options.txt + optionsof.txt применяются перед каждым запуском." />
                                        <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                                   Text="• Микрофон ассета: SHA-1 проверки и докачка только нехватающего." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="card" Margin="9,0,0,0">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="h3" Text="Совет дня" />
                                        <Border Classes="divider" />
                                        <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                                   Text="Если FPS меньше 60 — переключись на профиль 🥔 Potato и выставь ОЗУ ровно по реальным потребностям (обычно 2048 МБ хватает с головой). Лишние гигабайты только удлиняют GC-паузы." />
                                        <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                                   Text="Если игра вылетает после загрузки — открой Java и JVM, отключи «Использовать оптимизированные флаги», проверь, что Java 8 64-bit." />
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </Grid>
                    </Grid>

                    <!-- Graphics -->
                    <ScrollViewer IsVisible="{Binding IsGraphicsTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
                            <TextBlock Classes="h1" Text="Графика и FPS" />
                            <TextBlock Classes="subtitle" Text="Все настройки переписываются в options.txt перед каждым запуском." />

                            <Border Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="h3" Text="Базовые" />
                                    <Border Classes="divider" />

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                        <StackPanel Classes="cell" Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <DockPanel>
                                                <TextBlock Classes="label" Text="Render distance (чанки)" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding RenderDistance}" Classes="h3" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <Slider Minimum="2" Maximum="32" TickFrequency="1" Value="{Binding RenderDistance}" />
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="0" Grid.Column="1" Spacing="6">
                                            <DockPanel>
                                                <TextBlock Classes="label" Text="Simulation distance" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding SimulationDistance}" Classes="h3" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <Slider Minimum="2" Maximum="32" TickFrequency="1" Value="{Binding SimulationDistance}" />
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="1" Grid.Column="0" Spacing="6">
                                            <DockPanel>
                                                <TextBlock Classes="label" Text="Лимит FPS" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding MaxFpsDisplay}" Classes="h3" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <Slider Minimum="30" Maximum="260" TickFrequency="10" Value="{Binding MaxFps}" />
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="label" Text="Графика" />
                                            <ComboBox SelectedIndex="{Binding GraphicsMode}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Fast — максимум FPS" />
                                                <ComboBoxItem Content="Fancy" />
                                                <ComboBoxItem Content="Fabulous" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="2" Grid.Column="0" Spacing="6">
                                            <TextBlock Classes="label" Text="Частицы" />
                                            <ComboBox SelectedIndex="{Binding Particles}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Все" />
                                                <ComboBoxItem Content="Уменьшено" />
                                                <ComboBoxItem Content="Минимум" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="2" Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="label" Text="Плавное освещение (AO)" />
                                            <ComboBox SelectedIndex="{Binding SmoothLighting}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Выкл." />
                                                <ComboBoxItem Content="Минимум" />
                                                <ComboBoxItem Content="Максимум" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="h3" Text="Дополнительно" />
                                    <Border Classes="divider" />

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                        <StackPanel Classes="cell" Grid.Row="0" Grid.Column="0" Spacing="6">
                                            <DockPanel>
                                                <TextBlock Classes="label" Text="Mipmap уровень" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding MipmapLevels}" Classes="h3" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="4" TickFrequency="1" Value="{Binding MipmapLevels}" />
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="0" Grid.Column="1" Spacing="6">
                                            <DockPanel>
                                                <TextBlock Classes="label" Text="Biome blend" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding BiomeBlend}" Classes="h3" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="14" TickFrequency="1" Value="{Binding BiomeBlend}" />
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="1" Grid.Column="0" Spacing="6">
                                            <DockPanel>
                                                <TextBlock Classes="label" Text="Дистанция сущностей" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding EntityDistanceDisplay}" Classes="h3" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <Slider Minimum="0.5" Maximum="5" TickFrequency="0.25" Value="{Binding EntityDistance}" />
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="1" Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="label" Text="Громкость" />
                                            <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding MasterVolume}" />
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="2" Grid.Column="0" Spacing="10">
                                            <CheckBox IsChecked="{Binding Clouds}" Content="Облака" />
                                            <CheckBox IsChecked="{Binding EntityShadows}" Content="Тени сущностей" />
                                            <CheckBox IsChecked="{Binding ViewBobbing}" Content="Качание камеры" />
                                        </StackPanel>

                                        <StackPanel Classes="cell" Grid.Row="2" Grid.Column="1" Spacing="10">
                                            <CheckBox IsChecked="{Binding VSync}" Content="V-Sync" />
                                            <CheckBox IsChecked="{Binding Fullscreen}" Content="Полный экран" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="h3" Text="Окно игры" />
                                    <Border Classes="divider" />

                                    <Grid ColumnDefinitions="*,*,*">
                                        <StackPanel Classes="cell" Grid.Column="0" Spacing="6">
                                            <TextBlock Classes="label" Text="Ширина" />
                                            <TextBox Text="{Binding WindowWidth}" />
                                        </StackPanel>
                                        <StackPanel Classes="cell" Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="label" Text="Высота" />
                                            <TextBox Text="{Binding WindowHeight}" />
                                        </StackPanel>
                                        <StackPanel Classes="cell" Grid.Column="2" Spacing="6">
                                            <TextBlock Classes="label" Text="Пресет" />
                                            <ComboBox SelectedIndex="{Binding ResolutionPresetIndex}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Свой размер" />
                                                <ComboBoxItem Content="1280×720 (HD)" />
                                                <ComboBoxItem Content="1366×768" />
                                                <ComboBoxItem Content="1600×900" />
                                                <ComboBoxItem Content="1920×1080 (Full HD)" />
                                                <ComboBoxItem Content="854×480" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- OptiFine -->
                    <ScrollViewer IsVisible="{Binding IsOptifineTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
                            <TextBlock Classes="h1" Text="OptiFine" />
                            <TextBlock Classes="subtitle" Text="Применяется через optionsof.txt при каждом запуске." />

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding InstallOptifine}"
                                              Content="Устанавливать OptiFine 1.16.5 HD U G8" FontWeight="SemiBold" />
                                    <TextBlock Classes="dim" TextWrapping="Wrap"
                                               Text="Скачивается с optifine.net в headless-режиме при первом запуске. Если выключить — игра запустится в чистом vanilla 1.16.5 без OptiFine-настроек ниже." />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="h3" Text="FPS-бустеры" />
                                    <Border Classes="divider" />

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <CheckBox Classes="cell" Grid.Row="0" Grid.Column="0" IsChecked="{Binding OfFastRender}" Content="Fast Render" />
                                        <CheckBox Classes="cell" Grid.Row="0" Grid.Column="1" IsChecked="{Binding OfFastMath}" Content="Fast Math" />
                                        <CheckBox Classes="cell" Grid.Row="1" Grid.Column="0" IsChecked="{Binding OfDynamicFps}" Content="Dynamic FPS" />
                                        <CheckBox Classes="cell" Grid.Row="1" Grid.Column="1" IsChecked="{Binding OfSmartAnimations}" Content="Smart Animations" />
                                        <CheckBox Classes="cell" Grid.Row="2" Grid.Column="0" IsChecked="{Binding OfLazyChunkLoading}" Content="Lazy Chunk Loading" />
                                        <CheckBox Classes="cell" Grid.Row="2" Grid.Column="1" IsChecked="{Binding OfRenderRegions}" Content="Render Regions" />
                                        <CheckBox Classes="cell" Grid.Row="3" Grid.Column="0" IsChecked="{Binding OfShowFps}" Content="Показывать FPS в игре" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="h3" Text="Анимации (выключи для +FPS)" />
                                    <Border Classes="divider" />

                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
                                        <CheckBox Classes="cell" Grid.Row="0" Grid.Column="0" IsChecked="{Binding OfAnimatedWater}" Content="Вода" />
                                        <CheckBox Classes="cell" Grid.Row="0" Grid.Column="1" IsChecked="{Binding OfAnimatedLava}" Content="Лава" />
                                        <CheckBox Classes="cell" Grid.Row="0" Grid.Column="2" IsChecked="{Binding OfAnimatedFire}" Content="Огонь" />
                                        <CheckBox Classes="cell" Grid.Row="1" Grid.Column="0" IsChecked="{Binding OfAnimatedPortal}" Content="Портал" />
                                        <CheckBox Classes="cell" Grid.Row="1" Grid.Column="1" IsChecked="{Binding OfAnimatedRedstone}" Content="Редстоун" />
                                        <CheckBox Classes="cell" Grid.Row="1" Grid.Column="2" IsChecked="{Binding OfAnimatedExplosion}" Content="Взрывы" />
                                        <CheckBox Classes="cell" Grid.Row="2" Grid.Column="0" IsChecked="{Binding OfAnimatedTextures}" Content="Текстуры" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="h3" Text="Графика" />
                                    <Border Classes="divider" />

                                    <Grid ColumnDefinitions="*,*,*">
                                        <StackPanel Classes="cell" Grid.Column="0" Spacing="6">
                                            <TextBlock Classes="label" Text="Антиалиасинг (AA)" />
                                            <ComboBox SelectedIndex="{Binding OfAaLevelIndex}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="OFF" />
                                                <ComboBoxItem Content="2" />
                                                <ComboBoxItem Content="4" />
                                                <ComboBoxItem Content="8" />
                                                <ComboBoxItem Content="16" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Classes="cell" Grid.Column="1" Spacing="6">
                                            <TextBlock Classes="label" Text="Анизотропная фильтрация (AF)" />
                                            <ComboBox SelectedIndex="{Binding OfAfLevelIndex}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="OFF" />
                                                <ComboBoxItem Content="2" />
                                                <ComboBoxItem Content="4" />
                                                <ComboBoxItem Content="8" />
                                                <ComboBoxItem Content="16" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Classes="cell" Grid.Column="2" Spacing="6">
                                            <TextBlock Classes="label" Text="Chunk updates" />
                                            <ComboBox SelectedIndex="{Binding OfChunkUpdatesIndex}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="1 (минимум)" />
                                                <ComboBoxItem Content="2" />
                                                <ComboBoxItem Content="3" />
                                                <ComboBoxItem Content="4" />
                                                <ComboBoxItem Content="5" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Java -->
                    <ScrollViewer IsVisible="{Binding IsJavaTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
                            <TextBlock Classes="h1" Text="Java и JVM" />
                            <TextBlock Classes="subtitle" Text="По умолчанию используется встроенная Adoptium Temurin JRE 8u." />

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Путь к Java" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="dim" Text="Оставь пустым для авто-выбора (встроенная Adoptium → системная java)." />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding CustomJavaPath}"
                                                 Watermark="C:\Program Files\Java\jdk-8\bin\javaw.exe" />
                                        <Button Grid.Column="1" Content="Выбрать…" Command="{Binding PickJavaCommand}" />
                                    </Grid>
                                    <TextBlock Classes="dim" Text="{Binding ResolvedJavaPath}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="JVM-флаги" />
                                    <Border Classes="divider" />
                                    <CheckBox IsChecked="{Binding UseOptimizedFlags}"
                                              Content="Использовать оптимизированные флаги (G1GC, Aikar)" FontWeight="SemiBold" />
                                    <TextBlock Classes="label" Text="Дополнительные аргументы" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding CustomJvmArgs}" AcceptsReturn="True"
                                             Watermark="-XX:+UseShenandoahGC -Dfoo=bar" Height="80" />
                                    <TextBlock Classes="dim"
                                               Text="Добавляются к выбранным флагам. Через пробел." />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Поведение лаунчера" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="label" Text="После запуска игры" />
                                    <ComboBox SelectedIndex="{Binding PostLaunchAction}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Оставить лаунчер открытым" />
                                        <ComboBoxItem Content="Свернуть лаунчер" />
                                        <ComboBoxItem Content="Закрыть лаунчер" />
                                    </ComboBox>
                                    <TextBlock Classes="label" Text="Pre-launch команда (опционально)" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding PreLaunchCommand}"
                                             Watermark="cmd /c echo started %DATE% >> log.txt" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Servers -->
                    <ScrollViewer IsVisible="{Binding IsServersTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">
                            <TextBlock Classes="h1" Text="Серверы" />
                            <TextBlock Classes="subtitle" Text="Авто-подключение при старте игры." />

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Авто-подключение" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="label" Text="Адрес сервера (host или host:port)" />
                                    <TextBox Text="{Binding AutoConnectServer}" Watermark="play.example.net:25565" />
                                    <TextBlock Classes="dim" Text="Оставь пустым, чтобы попадать в главное меню." />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Быстрый выбор" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="dim" Text="Кнопка подставит адрес в поле выше." />
                                    <ItemsControl Name="ServerList" ItemsSource="{Binding ServerSuggestions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Button Margin="0,0,8,8"
                                                        Content="{Binding}"
                                                        Command="{Binding #ServerList.((vm:MainViewModel)DataContext).PickServerCommand}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Account -->
                    <ScrollViewer IsVisible="{Binding IsAccountTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="16" MaxWidth="900">
                            <TextBlock Classes="h1" Text="Профиль" />

                            <Border Classes="card">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14"
                                            Background="{DynamicResource AccentBrush}">
                                        <TextBlock Text="{Binding NicknameInitial}" Foreground="#000"
                                                   FontWeight="Black" FontSize="28"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Classes="cell" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Classes="h2" Text="{Binding Nickname}" />
                                        <TextBlock Classes="subtitle" Text="{Binding AccountModeLabel}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Microsoft аккаунт" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                               Text="Лаунчер откроет страницу microsoft.com/link, где ты подтвердишь короткий код. Нужна лицензия Minecraft (Java Edition) на этом аккаунте." />
                                    <Button Classes="primary" Content="Войти через Microsoft"
                                            Command="{Binding MicrosoftLoginCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Тип входа по умолчанию" />
                                    <Border Classes="divider" />
                                    <ComboBox SelectedIndex="{Binding AuthModeIndex}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Офлайн (любой ник, без премиум-серверов)" />
                                        <ComboBoxItem Content="Microsoft (премиум-аккаунт)" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Сброс" />
                                    <Border Classes="divider" />
                                    <Button Classes="danger" Content="Сбросить аккаунт"
                                            Command="{Binding LogoutCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tools -->
                    <ScrollViewer IsVisible="{Binding IsToolsTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="16" MaxWidth="1100">
                            <TextBlock Classes="h1" Text="Инструменты" />
                            <TextBlock Classes="subtitle" Text="Быстрый доступ к папкам, кэшу и логу." />

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Папки" />
                                    <Border Classes="divider" />
                                    <Grid ColumnDefinitions="*,*,*">
                                        <Button Classes="cell" Grid.Column="0" Content="Открыть .minecraft"
                                                Command="{Binding OpenGameDirCommand}" HorizontalAlignment="Stretch" />
                                        <Button Classes="cell" Grid.Column="1" Content="Открыть моды"
                                                Command="{Binding OpenModsDirCommand}" HorizontalAlignment="Stretch" />
                                        <Button Classes="cell" Grid.Column="2" Content="Открыть скриншоты"
                                                Command="{Binding OpenScreenshotsDirCommand}" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Кэш" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                               Text="Удаляет загруженные ассеты и нативы. При следующем запуске они скачаются заново. Сейвы и моды НЕ удаляются." />
                                    <Button Classes="danger" Content="Очистить кэш ассетов"
                                            Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Лог лаунчера" />
                                    <Border Classes="divider" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding LogText}" IsReadOnly="True"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 FontFamily="Consolas, Menlo, monospace" Height="240" />
                                        <StackPanel Classes="cell" Grid.Column="1" Spacing="8">
                                            <Button Content="Обновить" Command="{Binding RefreshLogCommand}" />
                                            <Button Content="Очистить" Command="{Binding ClearLogCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Content (mods/shaders/resourcepacks/perf-pack/backups) -->
                    <ScrollViewer IsVisible="{Binding IsContentTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="16" MaxWidth="1100">
                            <TextBlock Classes="h1" Text="Контент" />
                            <TextBlock Classes="subtitle"
                                       Text="Управление модами, шейдерами, ресурспаками и бэкапами миров." />

                            <!-- Performance pack -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Performance Pack (Forge 1.16.5)" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                               Text="Скачивает FerriteCore + Krypton + Starlight + SmoothBoot + EntityCulling + MemoryLeakFix в папку mods/. Forge installer открывается отдельно — в нём один раз нажмите «Install client»." />
                                    <ItemsControl ItemsSource="{Binding PerformanceMods}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,2">
                                                    <TextBlock Text="•" Width="12" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Classes="dim" Text="{Binding Description}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Classes="primary" HorizontalAlignment="Left"
                                            Content="Установить Performance Pack"
                                            Command="{Binding InstallPerformancePackCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Mods -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Classes="h3" Grid.Column="0" Text="Моды" />
                                        <Button Grid.Column="1" Content="Импорт .jar"
                                                Command="{Binding ImportModCommand}" />
                                        <Button Grid.Column="2" Content="Обновить" Margin="6,0,0,0"
                                                Command="{Binding RefreshContentCommand}" />
                                    </Grid>
                                    <Border Classes="divider" />
                                    <ItemsControl ItemsSource="{Binding ModItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2,0,2">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                              Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleContentCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Name}" />
                                                        <TextBlock Classes="dim" Text="{Binding FullPath}" FontSize="10" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Classes="dim"
                                                               Text="{Binding Size, StringFormat='{}{0:N0} б'}"
                                                               VerticalAlignment="Center" Margin="6,0,12,0" />
                                                    <Button Grid.Column="3" Content="✕"
                                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).DeleteContentCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Shaderpacks catalog -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Шейдеры — каталог low-end" />
                                    <Border Classes="divider" />
                                    <ItemsControl ItemsSource="{Binding ShaderCatalog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Classes="dim" Text="{Binding Description}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Скачать"
                                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).DownloadShaderCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Installed shaderpacks -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="h3" Grid.Column="0" Text="Установленные шейдеры" />
                                        <Button Grid.Column="1" Content="Импорт .zip"
                                                Command="{Binding ImportShaderCommand}" />
                                    </Grid>
                                    <Border Classes="divider" />
                                    <ItemsControl ItemsSource="{Binding ShaderItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,2">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                              Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleContentCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0" />
                                                    <Button Grid.Column="2" Content="✕"
                                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).DeleteContentCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Resourcepacks -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="h3" Grid.Column="0" Text="Ресурспаки" />
                                        <Button Grid.Column="1" Content="Импорт .zip"
                                                Command="{Binding ImportResourcepackCommand}" />
                                    </Grid>
                                    <Border Classes="divider" />
                                    <ItemsControl ItemsSource="{Binding ResourcePackItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,2">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}"
                                                              Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleContentCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0" />
                                                    <Button Grid.Column="2" Content="✕"
                                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).DeleteContentCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Backups -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <TextBlock Classes="h3" Grid.Column="0" Text="Бэкапы миров" />
                                        <Button Grid.Column="1" Classes="primary" Content="Создать бэкап"
                                                Command="{Binding CreateBackupCommand}" />
                                        <Button Grid.Column="2" Content="Папка" Margin="6,0,0,0"
                                                Command="{Binding OpenBackupsFolderCommand}" />
                                        <Button Grid.Column="3" Content="Обновить" Margin="6,0,0,0"
                                                Command="{Binding RefreshBackupsCommand}" />
                                    </Grid>
                                    <Border Classes="divider" />
                                    <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                               Text="Перед восстановлением текущая папка saves автоматически архивируется (before-restore-…zip)." />
                                    <ItemsControl ItemsSource="{Binding Backups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2,0,2">
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                                                        <TextBlock Classes="dim"
                                                                   Text="{Binding Created, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Classes="dim"
                                                               Text="{Binding SizeBytes, StringFormat='{}{0:N0} б'}"
                                                               VerticalAlignment="Center" Margin="6,0,12,0" />
                                                    <Button Grid.Column="2" Content="Восстановить"
                                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).RestoreBackupCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Grid.Column="3" Content="✕" Margin="6,0,0,0"
                                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).DeleteBackupCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Community: news, stats, leaderboard, skin, screenshots, settings i/o, crash analyzer -->
                    <ScrollViewer IsVisible="{Binding IsCommunityTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="16" MaxWidth="1100">
                            <TextBlock Classes="h1" Text="Сообщество" />

                            <!-- News -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="h3" Text="Новости" />
                                        <Button Grid.Column="1" Content="Обновить"
                                                Command="{Binding RefreshNewsCommand}" />
                                    </Grid>
                                    <Border Classes="divider" />
                                    <ItemsControl ItemsSource="{Binding NewsItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,4,0,8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Classes="dim" Text="{Binding Date}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Online stats / leaderboard -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="h3" Text="Онлайн PcLun" />
                                        <Button Grid.Column="1" Content="Обновить"
                                                Command="{Binding RefreshLeaderboardCommand}" />
                                    </Grid>
                                    <Border Classes="divider" />
                                    <TextBlock Text="{Binding StatsLine}" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="label" Text="Топ игроков (по числу сессий)" />
                                    <ItemsControl ItemsSource="{Binding LeaderboardItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="40,*,Auto" Margin="0,2,0,2">
                                                    <TextBlock Grid.Column="0" Text="•" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                                    <TextBlock Grid.Column="2" Classes="dim"
                                                               Text="{Binding Sessions, StringFormat='{}{0} сессий'}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Personal stats + skin -->
                            <Border Classes="card">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="120" Height="240"
                                            Background="{DynamicResource BgPanelBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding SkinFullBodyUrl}"
                                               Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6">
                                        <TextBlock Classes="h3" Text="Моя статистика" />
                                        <Border Classes="divider" />
                                        <TextBlock Text="{Binding PlayerStatsLine}" TextWrapping="Wrap" />
                                        <TextBlock Classes="dim"
                                                   Text="{Binding LastServerLine, StringFormat='Последний сервер: {0}'}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Crash analyzer -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="h3" Text="Анализатор крашей" />
                                        <Button Grid.Column="1" Content="Сканировать"
                                                Command="{Binding ScanCrashesCommand}" />
                                    </Grid>
                                    <Border Classes="divider" />
                                    <TextBlock Text="{Binding CrashStatus}" Classes="subtitle" />
                                    <ItemsControl ItemsSource="{Binding CrashEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,4,0,4" Padding="10"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Classes="dim"
                                                                       Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Diagnosis}" />
                                                        <TextBlock Classes="dim" Text="{Binding Suggestion}" TextWrapping="Wrap" />
                                                        <Button Content="Открыть файл"
                                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenCrashCommand}"
                                                                CommandParameter="{Binding}" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Screenshots -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Classes="h3" Text="Скриншоты" />
                                        <Button Grid.Column="1" Content="Обновить"
                                                Command="{Binding RefreshScreenshotsCommand}" />
                                    </Grid>
                                    <Border Classes="divider" />
                                    <ItemsControl ItemsSource="{Binding Screenshots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="4" Padding="0"
                                                        Command="{Binding #Root.((vm:MainViewModel)DataContext).OpenScreenshotCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Image Source="{Binding}" Width="160" Height="90" Stretch="UniformToFill" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Settings I/O + update -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Настройки и обновление" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="subtitle"
                                               Text="{Binding CurrentLauncherVersion, StringFormat='Текущая версия: {0}'}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Проверить обновления" Command="{Binding CheckUpdateCommand}" />
                                        <Button Content="Открыть Releases" Command="{Binding OpenLatestReleaseCommand}" />
                                    </StackPanel>
                                    <Border Classes="divider" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Экспорт настроек" Command="{Binding ExportSettingsCommand}" />
                                        <Button Content="Импорт настроек" Command="{Binding ImportSettingsCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pro: multi-instance, version, Modrinth, server browser, friends, chat, achievements, diagnostics, theme, hosts -->
                    <ScrollViewer IsVisible="{Binding IsProTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="14" MaxWidth="1100">
                            <TextBlock Classes="h1" Text="Pro" />
                            <TextBlock Classes="subtitle"
                                       Text="Мульти-инстансы, версии, Modrinth, серверы, друзья, чат, диагностика, темы, хосты, тумблеры." />

                            <!-- Instances -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Инстансы (профили .minecraft)" />
                                    <ItemsControl ItemsSource="{Binding Instances}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2a2a2e" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Foreground="#888" FontSize="12">
                                                                <Run Text="{Binding McVersion}" />
                                                                <Run Text="·" />
                                                                <Run Text="{Binding Loader}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="Удалить"
                                                                IsVisible="{Binding !IsDefault}"
                                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).DeleteInstanceCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="180" Watermark="имя"
                                                 Text="{Binding NewInstanceName, Mode=TwoWay}" />
                                        <ComboBox SelectedItem="{Binding NewInstanceVersion, Mode=TwoWay}"
                                                  ItemsSource="{Binding AvailableMcVersions}" Width="120" />
                                        <ComboBox SelectedItem="{Binding NewInstanceLoader, Mode=TwoWay}" Width="120">
                                            <ComboBoxItem>forge</ComboBoxItem>
                                            <ComboBoxItem>fabric</ComboBoxItem>
                                            <ComboBoxItem>optifine</ComboBoxItem>
                                            <ComboBoxItem>vanilla</ComboBoxItem>
                                        </ComboBox>
                                        <Button Content="Создать" Command="{Binding CreateInstanceCommand}" />
                                        <Button Content="Обновить версии MC" Command="{Binding RefreshVersionsCommand}" />
                                        <Button Content="Импорт модпака (.zip / .mrpack)" Command="{Binding ImportModpackCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Modrinth browser -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Modrinth — каталог модов" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="300" Watermark="поиск (jei, sodium…)"
                                                 Text="{Binding ModrinthQuery, Mode=TwoWay}" />
                                        <ComboBox SelectedItem="{Binding ModrinthMcVersion, Mode=TwoWay}"
                                                  ItemsSource="{Binding AvailableMcVersions}" Width="120" />
                                        <ComboBox SelectedItem="{Binding ModrinthLoader, Mode=TwoWay}" Width="120">
                                            <ComboBoxItem>forge</ComboBoxItem>
                                            <ComboBoxItem>fabric</ComboBoxItem>
                                        </ComboBox>
                                        <Button Content="Поиск" Command="{Binding ModrinthSearchCommand}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ModrinthResults}" MaxHeight="280">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2a2a2e" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                            <TextBlock Foreground="#888" FontSize="12"
                                                                       Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Установить"
                                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).ModrinthInstallCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Server browser -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Браузер серверов (MC ping)" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="300" Watermark="play.hypixel.net"
                                                 Text="{Binding ServerPingInput, Mode=TwoWay}" />
                                        <Button Content="Пинг" Command="{Binding PingServerCommand}" />
                                        <Button Content="Пинг рекомендованных" Command="{Binding PingFeaturedCommand}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ServerEntries}" MaxHeight="220">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2a2a2e" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                                                        <TextBlock Foreground="#888" FontSize="12" Text="{Binding Motd}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- One-click loader installers -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Установщики (Replay, Sodium, Iris, Vivecraft, Fabric)" />
                                    <ItemsControl ItemsSource="{Binding Installers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2a2a2e" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Foreground="#888" FontSize="12"
                                                                       Text="{Binding Description}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Установить"
                                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).InstallExtraCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Friends -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Друзья" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="220" Watermark="ник друга"
                                                 Text="{Binding FriendToAdd, Mode=TwoWay}" />
                                        <Button Content="Добавить" Command="{Binding AddFriendCommand}" />
                                        <Button Content="Обновить" Command="{Binding RefreshFriendsCommand}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Friends}" MaxHeight="200">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2a2a2e" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Margin="8,0">
                                                            <Run Text="{Binding Sessions}" /><Run Text=" сессий" />
                                                        </TextBlock>
                                                        <Button Grid.Column="2" Content="Удалить"
                                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveFriendCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Chat -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Чат лаунчера (WebSocket)" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Подключиться" Command="{Binding ConnectChatCommand}" />
                                        <TextBlock VerticalAlignment="Center" Foreground="#888"
                                                   Text="{Binding ChatStatus}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ChatMessages}" MaxHeight="200">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}" FontFamily="Consolas,Courier New,monospace" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="500" Watermark="сообщение…"
                                                 Text="{Binding ChatInput, Mode=TwoWay}" />
                                        <Button Content="Отправить" Command="{Binding SendChatCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Achievements -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Достижения" />
                                    <Button Content="Обновить" Command="{Binding RefreshAchievementsCommand}" HorizontalAlignment="Left" />
                                    <ItemsControl ItemsSource="{Binding Achievements}" MaxHeight="200">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2a2a2e" BorderThickness="0,0,0,1" Padding="0,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Icon}" FontSize="18" />
                                                        <TextBlock Text="{Binding Title}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Diagnostics -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Диагностика (GPU, температура, моды)" />
                                    <Button Content="Запустить диагностику" Command="{Binding RunDiagnosticsCommand}" HorizontalAlignment="Left" />
                                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="GPU:" Foreground="#888" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GpuName}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Предупреждение:" Foreground="#888" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuWarning}" Foreground="#fbbf24" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Температура CPU:" Foreground="#888" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CpuTemp}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Конфликты модов:" Foreground="#888" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModConflictSummary}" />
                                    </Grid>
                                    <TextBlock Text="{Binding AntiCheatSummary}" FontStyle="Italic" Foreground="#888" />
                                </StackPanel>
                            </Border>

                            <!-- Cloud backup -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Облачный бэкап последнего снимка" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Загрузить" Command="{Binding CloudBackupCommand}" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding CloudBackupStatus}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Theme + accent -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Тема и акцент" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox SelectedIndex="{Binding ThemeMode, Mode=TwoWay}" Width="180">
                                            <ComboBoxItem>Тёмная</ComboBoxItem>
                                            <ComboBoxItem>Светлая</ComboBoxItem>
                                            <ComboBoxItem>Системная</ComboBoxItem>
                                        </ComboBox>
                                        <TextBox Width="120" Watermark="#4ADE80"
                                                 Text="{Binding AccentColor, Mode=TwoWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Hosts editor -->
                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="Hosts (альтернативные DNS)" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Прочитать /etc/hosts" Command="{Binding RefreshHostsCommand}" />
                                        <Button Content="Сохранить патч (нужно ручное применение)"
                                                Command="{Binding StageHostsPatchCommand}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding HostsMappings}" MaxHeight="160">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Ip}" />
                                                    <Run Text=" → " />
                                                    <Run Text="{Binding Host}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding HostsPatchInfo}" FontFamily="Consolas,Courier New,monospace"
                                               Foreground="#888" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Toggles -->
                            <Border Classes="card">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="h2" Text="Переключатели" />
                                    <CheckBox Content="Стример-режим (скрывать ник, токены, IP серверов)"
                                              IsChecked="{Binding StreamerModeEnabled, Mode=TwoWay}" />
                                    <CheckBox Content="Компактный режим окна (520×380)"
                                              IsChecked="{Binding CompactMode, Mode=TwoWay}" />
                                    <CheckBox Content="Запускать с системой (autostart)"
                                              IsChecked="{Binding AutostartWithOs, Mode=TwoWay}" />
                                    <CheckBox Content="Системные уведомления (toast)"
                                              IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}" />
                                    <CheckBox Content="Анонимная телеметрия (краши, FPS, GPU)"
                                              IsChecked="{Binding TelemetryEnabled, Mode=TwoWay}" />
                                    <CheckBox Content="Авто-FPS-профиль по железу"
                                              IsChecked="{Binding AutoFpsProfile, Mode=TwoWay}" />
                                    <CheckBox Content="Network tuner (TCP/IPv4 JVM-аргументы)"
                                              IsChecked="{Binding NetworkTunerEnabled, Mode=TwoWay}" />
                                    <CheckBox Content="Понижать приоритет фоновых процессов (Chrome/Discord)"
                                              IsChecked="{Binding DemoteBackgroundProcs, Mode=TwoWay}" />
                                    <CheckBox Content="Скачивать обновления в фоне"
                                              IsChecked="{Binding BackgroundUpdateEnabled, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- About -->
                    <ScrollViewer IsVisible="{Binding IsAboutTab}" Padding="36,32,36,28">
                        <StackPanel Spacing="16" MaxWidth="900">
                            <TextBlock Classes="h1" Text="О лаунчере" />

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h2" Text="PcLun" />
                                    <TextBlock Classes="subtitle"
                                               Text="{Binding CurrentLauncherVersion, StringFormat='Версия {0} · Theme 2026'}" />
                                    <Border Classes="divider" />
                                    <TextBlock Classes="subtitle" TextWrapping="Wrap"
                                               Text="Минималистичный лаунчер Minecraft 1.16.5 с авто-установкой OptiFine, профилями FPS-оптимизации и онлайн-счётчиком." />
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Автор" />
                                    <Border Classes="divider" />
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Border Width="56" Height="56" CornerRadius="28"
                                                Background="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="M" FontSize="28" FontWeight="Black"
                                                       Foreground="#000000"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="h2" Text="MrDomik" />
                                            <TextBlock Classes="dim" Text="автор лаунчера" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Classes="divider" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="GitHub репозиторий"
                                                Click="OpenGithub_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="card">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="h3" Text="Системная информация" />
                                    <Border Classes="divider" />
                                    <TextBlock Text="{Binding OsName}" />
                                    <TextBlock Text="{Binding RamInfo}" />
                                    <TextBlock Text="{Binding ArchInfo}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    </Grid>
                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>
